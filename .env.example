# Prévia permanece fora dos mecanismos de busca por padrão.
PUBLIC_SITE_MODE=preview
# false encerra os convites para modelos em todas as páginas.
PUBLIC_RECRUITMENT_ACTIVE=true
# Preencher somente com o domínio final verificado (origem HTTPS, sem caminho).
PUBLIC_SITE_URL=
# Contatos oficiais, opcionais durante a prévia. Número internacional, apenas dígitos.
PUBLIC_WHATSAPP=5541999179039
PUBLIC_INSTAGRAM=
PUBLIC_CITY=
PUBLIC_NEIGHBORHOOD=
# Somente endereço completo aprovado para publicação. O schema usa Organization
# até esses dados serem confirmados; não preencher com valores ilustrativos.
PUBLIC_STREET_ADDRESS=
PUBLIC_POSTAL_CODE=
