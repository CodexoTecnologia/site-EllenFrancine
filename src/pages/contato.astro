---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Action from '../components/Action.astro';
import Icon from '../components/Icon.astro';
import { site, locationLabel } from '../config/site';
---

<Base
  title="Contato com Ellen Francine em Colombo"
  description={`Fale com Ellen Francine no WhatsApp ${site.phoneLabel}. Atendimento em Roça Grande, Colombo, PR. Consulte disponibilidade e combine os detalhes diretamente.`}
>
  <PageHero
    eyebrow="O PRÓXIMO PASSO É CONVERSAR"
    title="Seu olhar merece"
    accent="esse carinho."
    description={
      site.recruitmentActive
        ? 'Tem vontade de conhecer o atendimento ou de ser modelo de treinamento? Vai ser um prazer conversar com você.'
        : 'Tem vontade de conhecer o atendimento? Vai ser um prazer conversar com você.'
    }
  >
    <Action href={site.contactUrl} external>
      {site.contactLabel}
    </Action>
  </PageHero>
  <section class="section shell">
    <div class="contact-page-grid">
      <div>
        {site.whatsapp && (
          <div class="contact-item">
            <span class="eyebrow">WHATSAPP / ATENDIMENTO</span>
            <a href={site.contactUrl} target="_blank" rel="noopener noreferrer">
              {site.phoneLabel} <Icon size={22} />
            </a>
            <p>Envie sua mensagem e combine os detalhes diretamente com a Ellen.</p>
          </div>
        )}
        <div class="contact-item">
          <span class="eyebrow">INSTAGRAM / AGENDAMENTO PELO DIRECT</span>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
            {site.instagramHandle}
            <Icon size={22} />
          </a>
          <p>
            Abra o perfil e envie uma mensagem pelo direct. A Ellen confirma as informações e
            combina o horário com você.
          </p>
        </div>
        <div class="contact-item">
          <span class="eyebrow">LOCALIZAÇÃO</span>
          <h2 style="font-size:var(--s5)">{locationLabel}</h2>
          {site.streetAddress && site.postalCode ? (
            <p>
              {site.streetAddress} · CEP {site.postalCode}
              <br />
              {locationLabel}
            </p>
          ) : (
            <p>
              O endereço completo é informado diretamente na conversa, antes de confirmar o
              atendimento.
            </p>
          )}
        </div>
        <div class="contact-item">
          <span class="eyebrow">DISPONIBILIDADE</span>
          <p>
            Consulte os dias, horários{site.recruitmentActive ? ', condições para modelos' : ''} e
            informações de atendimento pelo canal oficial.
          </p>
        </div>
      </div>
      <aside class="contact-card">
        <p class="eyebrow">VAMOS CONVERSAR</p>
        <h2>
          {site.recruitmentActive ? 'Quero ser' : 'Quero conhecer'}
          <br />
          <span>{site.recruitmentActive ? 'modelo.' : 'o atendimento.'}</span>
        </h2>
        <p>
          {site.recruitmentActive
            ? 'Estou procurando modelos para treinamento nesta nova fase como Lash Designer.'
            : 'Seu estilo é o ponto de partida para nossa conversa.'}{' '}
          Me chama {site.contactInstruction} para conhecer a proposta.
        </p>
        <Action href={site.contactUrl} external>
          Falar com a Ellen
        </Action>
        <small>
          O link abre o canal oficial. O horário será confirmado na conversa; não existe reserva
          automática por este site.
        </small>
      </aside>
    </div>
  </section>
</Base>
