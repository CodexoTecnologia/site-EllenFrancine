---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Action from '../components/Action.astro';
import ContactSection from '../components/ContactSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ServicePrices from '../components/ServicePrices.astro';
import { site } from '../config/site';
import { gallery } from '../data/content';
---

<Base
  title={
    site.recruitmentActive
      ? 'Extensão de cílios e modelos para treinamento em Colombo'
      : 'Extensão de cílios em Colombo'
  }
  description="Conheça Volume Brasileiro, 4D e 5D e confira os valores de extensão de cílios com Ellen Francine em Colombo, PR."
>
  <PageHero
    eyebrow="O ATENDIMENTO"
    title="O ponto de partida"
    accent="é o seu olhar."
    description="Um olhar delicado, definido ou marcante. Primeiro, vamos conversar sobre o que você gosta e conhecer as possibilidades do atendimento."
  />
  <section class="section paper" data-surface="light">
    <div class="shell detail-grid">
      <figure class="detail-photo">
        <Image
          src={gallery[1].image}
          alt={gallery[1].alt}
          widths={[480, 800, 1100]}
          sizes="(max-width:760px) 90vw,45vw"
          format="webp"
          loading="eager"
          style="object-position:42% 40%"
        />
      </figure>
      <div>
        <p class="eyebrow">EXTENSÃO DE CÍLIOS</p>
        <h2>
          Um carinho a mais
          <br />
          <span>para o seu olhar.</span>
        </h2>
        <p class="section-lead">
          Estou começando minha jornada como Lash Designer e quero dividir esse novo capítulo com
          você.
        </p>
        <p class="muted-copy">
          {site.recruitmentActive
            ? 'Neste momento, estou procurando modelos para treinamento.'
            : 'Conheça as possibilidades do atendimento.'}{' '}
          Conversamos {site.contactInstruction} sobre as opções e o tempo necessário.
        </p>
        <Action href={site.contactUrl} external>
          Conversar sobre o atendimento
        </Action>
        <p class="plain-note">
          Confira a tabela abaixo e converse comigo sobre duração e orientações antes de combinar o
          horário.
        </p>
      </div>
    </div>
  </section>
  <ServicePrices />
  <HowItWorks />
  <ContactSection />
</Base>
