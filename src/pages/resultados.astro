---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactSection from '../components/ContactSection.astro';
import GalleryViewer from '../components/GalleryViewer.astro';
import { gallery } from '../data/content';
import { site } from '../config/site';
const enlarged = await Promise.all(
  gallery.map((item) => getImage({ src: item.image, width: 1200, format: 'webp' })),
);
---

<Base
  title="Galeria de cílios em Colombo"
  description="Veja as imagens da publicação de lançamento de Ellen Francine, Lash Designer em Colombo. Acompanhe essa nova fase e converse pelo Instagram."
>
  <PageHero
    eyebrow="GALERIA / ELLEN FRANCINE"
    title="De perto,"
    accent="o olhar conta mais."
    description="Imagens da minha publicação de lançamento. Um registro dessa nova fase e um convite para você acompanhar os próximos passos."
  />
  <section class="section paper" data-surface="light">
    <div class="shell">
      <div class="full-gallery">
        {gallery.map((item, index) => (
          <figure data-photo>
            <a
              class="gallery-image-wrap"
              href={enlarged[index].src}
              data-gallery-photo
              data-photo-title={item.title}
              aria-label={`Ampliar fotografia: ${item.title}`}
            >
              <Image
                src={item.image}
                alt={item.alt}
                widths={[480, 800, 1200]}
                sizes={index === 2 ? '(max-width:760px) 90vw,950px' : '(max-width:760px) 90vw,45vw'}
                format="webp"
                loading={index === 0 ? 'eager' : 'lazy'}
                style={`object-position:${item.position}`}
              />
              <span class="photo-arrow">
                <Icon size={20} />
              </span>
            </a>
            <figcaption>
              <div>
                <p class="eyebrow">0{index + 1} / PUBLICAÇÃO DE LANÇAMENTO</p>
                <h2>{item.title}</h2>
                <p>{item.detail}</p>
              </div>
              <a href={site.launchPost} target="_blank" rel="noopener noreferrer">
                Ver no Instagram <Icon size={14} />
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="source-note">
        Cinco imagens da publicação de lançamento de {site.instagramHandle}. A galeria apresenta
        esse ensaio; técnicas e detalhes de atendimento são confirmados diretamente com a Ellen.
      </p>
    </div>
  </section>
  <ContactSection />
  <GalleryViewer />
</Base>
