---
interface Props {
  variant?: number;
  class?: string;
}
const { variant = 1, class: className } = Astro.props;
const count = variant === 1 ? 13 : variant === 2 ? 19 : 25;
const strokes = Array.from({ length: count }, (_, index) => {
  const t = index / (count - 1);
  const x = 55 + t * 390;
  const y = 172 - Math.sin(t * Math.PI) * 92;
  const length = 30 + Math.sin(t * Math.PI) * (variant === 1 ? 28 : variant === 2 ? 46 : 61);
  const dx = (t - 0.5) * 54;
  return `M${x},${y} Q${x + dx * 0.35},${y - length * 0.6} ${x + dx},${y - length}`;
});
---

<svg class:list={['lash-study', className]} viewBox="0 0 500 260" fill="none" aria-hidden="true">
  <path
    class="lash-outline"
    d="M45 180Q250-25 455 180Q250 264 45 180Z"
    stroke="currentColor"
    stroke-width="1.4"
  />
  <ellipse cx="250" cy="144" rx="42" ry="57" stroke="currentColor" stroke-width="1" />
  {strokes.map((d) => (
    <path
      d={d}
      stroke="currentColor"
      stroke-width={variant === 3 ? 2.8 : 1.8}
      stroke-linecap="round"
    />
  ))}
</svg>
