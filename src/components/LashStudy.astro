---
interface Props {
  variant?: number;
  class?: string;
}
const { variant = 1, class: className } = Astro.props;
const count = variant === 1 ? 13 : variant === 2 ? 21 : 27;
const strokes = Array.from({ length: count }, (_, index) => {
  const t = index / (count - 1);
  const x = 55 + t * 390;
  const y = 172 - Math.sin(t * Math.PI) * 92;
  const length =
    variant === 1
      ? 22 + Math.sin(t * Math.PI) * 28
      : variant === 2
        ? 26 + t * 46
        : 38 + Math.sin(t * Math.PI) * 57;
  const dx = variant === 2 ? 12 + t * 46 : (t - 0.5) * (variant === 3 ? 86 : 54);
  return `M${x},${y} Q${x + dx * 0.35},${y - length * 0.6} ${x + dx},${y - length}`;
});
---

<svg class:list={['lash-study', className]} viewBox="0 -24 500 284" fill="none" aria-hidden="true">
  <path
    class="lash-outline"
    d="M45 180Q250-25 455 180Q250 264 45 180Z"
    stroke="currentColor"
    stroke-width="1.4"
  />
  <ellipse cx="250" cy="144" rx="42" ry="57" stroke="currentColor" stroke-width="1" opacity="0.5" />
  <ellipse cx="250" cy="145" rx="17" ry="24" fill="currentColor" opacity="0.16" />
  {strokes.map((d) => (
    <path
      d={d}
      stroke="currentColor"
      stroke-width={variant === 3 ? 2.8 : 1.8}
      stroke-linecap="round"
    />
  ))}
  {variant === 3 &&
    strokes.map((d) => (
      <path
        d={d}
        transform="translate(5 3)"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
        opacity="0.55"
      />
    ))}
</svg>
