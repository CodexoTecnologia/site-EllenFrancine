---
import Action from './Action.astro';
import Icon from './Icon.astro';
import { site, locationLabel } from '../config/site';
---

<section class="contact-section section" id="conversar">
  <div class="shell contact-inner">
    <svg class="contact-signature" viewBox="0 0 300 80" fill="none" aria-hidden="true">
      <path
        d="M8 52C89 110 192-17 292 27"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      />
    </svg>
    <p class="eyebrow">SEU OLHAR MERECE ESSE CARINHO</p>
    <h2>
      Seu próximo olhar
      <br />
      <span>começa com uma conversa.</span>
    </h2>
    <p>
      {site.recruitmentActive
        ? 'Quer conhecer o atendimento ou participar como modelo de treinamento?'
        : 'Quer conhecer as possibilidades do atendimento?'}{' '}
      Fale comigo {site.contactInstruction}.
    </p>
    <Action href={site.contactUrl} external>
      {site.contactLabel}
    </Action>
    <span class="contact-location">
      <Icon name="location" size={15} />
      {locationLabel}
    </span>
  </div>
</section>
