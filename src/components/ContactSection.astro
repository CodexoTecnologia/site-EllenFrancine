---
import Action from './Action.astro';
import Icon from './Icon.astro';
import { site, locationLabel } from '../config/site';
---

<section class="contact-section section" id="conversar">
  <div class="shell contact-inner">
    <svg class="contact-signature" viewBox="0 0 300 80" fill="none" aria-hidden="true">
      <path
        d="M8 52C89 110 192-17 292 27"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      />
    </svg>
    <h2>
      Vamos realçar
      <br />
      <span>o seu olhar?</span>
    </h2>
    <p>Tire suas dúvidas e combine seu horário {site.contactInstruction}.</p>
    <Action href={site.contactUrl} external>
      {site.contactLabel}
    </Action>
    <span class="contact-location">
      <Icon name="location" size={15} />
      {locationLabel}
    </span>
  </div>
</section>
