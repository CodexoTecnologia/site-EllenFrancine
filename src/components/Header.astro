---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { navigation, site } from '../config/site';
const current = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <Brand />
    <nav class="desktop-nav" aria-label="Navegação principal">
      {navigation.map((item) => (
        <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <a class="header-contact" href="/contato/">
      Vamos conversar <Icon size={15} />
    </a>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Abrir menu de navegação">
        <span class="menu-label">Menu</span>
        <Icon name="menu" />
      </summary>
      <nav aria-label="Navegação móvel">
        {navigation.map((item) => (
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
            <Icon size={18} />
          </a>
        ))}
        <a href="/contato/">
          Contato
          <Icon size={18} />
        </a>
        <a class="mobile-instagram" href={site.instagram} target="_blank" rel="noopener noreferrer">
          {site.instagramHandle}
          <Icon name="instagram" size={18} />
        </a>
      </nav>
    </details>
  </div>
  <span class="scroll-progress" data-scroll-progress aria-hidden="true"></span>
</header>
