---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { site, locationLabel } from '../config/site';
---

<footer class="site-footer">
  <div class="shell footer-main">
    <div>
      <Brand />
      <p>Seu olhar merece esse carinho.</p>
    </div>
    <div>
      <span class="eyebrow">ENCONTRE A ELLEN</span>
      <a class="footer-phone" href={site.contactUrl} target="_blank" rel="noopener noreferrer">
        WhatsApp · {site.phoneLabel} <Icon size={16} />
      </a>
      <a class="footer-instagram" href={site.instagram} target="_blank" rel="noopener noreferrer">
        {site.instagramHandle}
        <Icon name="instagram" size={18} />
      </a>
      <p>{locationLabel}</p>
    </div>
  </div>
  <div class="shell footer-credit">
    <a
      class="codexo-credit"
      href="https://codexo.com.br"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Design e desenvolvimento por Codexo — conheça nosso trabalho"
    >
      <span class="codexo-credit-copy">
        <span class="codexo-credit-title">Design & desenvolvimento</span>
        <span class="codexo-credit-caption">Conheça o trabalho da Codexo</span>
      </span>
      <span class="codexo-credit-brand">
        <img src="/brand/codexo-white.svg" alt="Codexo" width="180" height="64" loading="lazy" />
        <span class="codexo-credit-arrow" aria-hidden="true">
          <Icon size={22} />
        </span>
      </span>
    </a>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Ellen Francine</span>
    <a href="/privacidade/">Privacidade</a>
    <button class="motion-toggle" data-motion-toggle type="button" aria-pressed="false" hidden>
      <span data-motion-label>Movimento</span>
      <Icon name="spark" size={13} />
    </button>
  </div>
</footer>
